# 方式一：公司内部网关（推荐，与 Claude Code 配置保持一致）
ANTHROPIC_BASE_URL=https://ai-gateway.insta360.cn
ANTHROPIC_AUTH_TOKEN=your-gateway-token

# 方式二：Anthropic 官方 API（二选一即可，若上面已配置则优先使用网关）
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# 可选：LLM 超时秒数，默认 45；正文较长或网关较慢时可临时调大
# LLM_TIMEOUT_SECONDS=45

# 可选：发送给 LLM 的最大正文字符数，默认 20000
# LLM_MAX_TEXT_CHARS=20000
