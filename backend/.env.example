# 方式一：Anthropic 官方 API（默认）
# 只需要把下一行的占位符替换成你的真实 API key。
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# 方式二：公司内部/自建兼容网关（二选一；启用网关时请同时填写下面两项）
# ANTHROPIC_BASE_URL=https://ai-gateway.insta360.cn
# ANTHROPIC_AUTH_TOKEN=YOUR_GATEWAY_TOKEN_HERE

# 可选：LLM 超时秒数，默认 45；正文较长或网关较慢时可临时调大
# LLM_TIMEOUT_SECONDS=45

# 可选：发送给 LLM 的最大正文字符数，默认 20000
# LLM_MAX_TEXT_CHARS=20000
